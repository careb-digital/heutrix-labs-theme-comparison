{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "heutrix-labs-refined",
  "main": "worker.js",
  "compatibility_date": "2026-09-05",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none",
    "html_handling": "none"
  }
}
